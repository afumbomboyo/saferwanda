{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user account information, selected security services, and hardware onboarding progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email" },
        "isAdmin": { "type": "boolean", "description": "Flag for platform administrators." },
        "servicesSelected": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of SafeRwanda service IDs user has opted into."
        },
        "isOnboarded": { "type": "boolean", "description": "Flag indicating if user finished initial setup." },
        "purchaseStatus": { 
          "type": "string", 
          "enum": ["none", "purchased", "leased"],
          "description": "Hardware procurement status."
        },
        "hasPaidSetupFee": { "type": "boolean", "description": "Whether the user opted for professional installation." },
        "deviceId": { "type": "string", "description": "The linked IoT hardware unique identifier." },
        "deviceName": { "type": "string", "description": "User-assigned name for the device." },
        "alertPhone": { "type": "string", "description": "Phone number for distress alerts." },
        "alertEmail": { "type": "string", "description": "Email address for distress alerts." },
        "subscriptionActive": { "type": "boolean", "description": "Whether the service subscription is current." },
        "subscriptionType": { 
          "type": "string", 
          "enum": ["none", "weekly", "monthly", "yearly"] 
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "isOnboarded"]
    },
    "Camera": {
      "title": "Camera",
      "description": "Information about registered security and traffic cameras.",
      "type": "object",
      "properties": {
        "camera_id": { "type": "string" },
        "name": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "road": { "type": "string" },
            "district": { "type": "string" },
            "city": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "owner": {
          "type": "object",
          "properties": {
            "organization": { "type": "string" }
          }
        },
        "services": {
          "type": "object",
          "properties": {
            "traffic_enforcement": { "type": "boolean" },
            "live_stream": { "type": "boolean" },
            "information_storage": { "type": "boolean" },
            "abnormal_activity_alert": { "type": "boolean" },
            "information_retrieval": { "type": "boolean" }
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "allowed_events": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "webhook_url": { "type": "string", "description": "The unique event webhook URL generated by Node-RED." }
      },
      "required": ["camera_id", "name"]
    },
    "PoliceOfficer": {
      "title": "Police Officer",
      "description": "Metadata for police officers enrolled in the SafeRwanda ecosystem.",
      "type": "object",
      "properties": {
        "police_id": { "type": "string" },
        "service_number": { "type": "string" },
        "identity": {
          "type": "object",
          "properties": {
            "first_name": { "type": "string" },
            "last_name": { "type": "string" },
            "full_name": { "type": "string" }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "employment": {
          "type": "object",
          "properties": {
            "rank": { "type": "string" },
            "station": { "type": "string" },
            "department": { "type": "string" }
          }
        },
        "role": { "type": "string", "enum": ["traffic_police", "police_admin"] },
        "status": { "type": "string", "enum": ["pending_enrollment", "enrollment_ready", "active", "suspended", "deactivated"] },
        "enrollment": {
          "type": "object",
          "properties": {
            "face": { "type": "object", "properties": { "enrolled": { "type": "boolean" } } },
            "pin": { "type": "object", "properties": { "configured": { "type": "boolean" } } },
            "completed": { "type": "boolean" },
            "enrolled_at": { "type": "string", "format": "date-time" },
            "enrolled_by": { "type": "string" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "PoliceAuditLog": {
      "title": "Police Audit Log",
      "description": "Records administrative actions performed on police officer accounts.",
      "type": "object",
      "properties": {
        "audit_id": { "type": "string" },
        "police_id": { "type": "string" },
        "action": { "type": "string" },
        "performed_by": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile document containing account settings, hardware status, and chosen services."
    },
    "/cameras/{cameraId}": {
      "schema": "#/backend/entities/Camera",
      "description": "Individual camera records in the registry."
    },
    "/police_officers/{officerId}": {
      "schema": "#/backend/entities/PoliceOfficer",
      "description": "Registry of police officers and their enrollment status."
    },
    "/police_audit_logs/{logId}": {
      "schema": "#/backend/entities/PoliceAuditLog",
      "description": "History of administrative actions on police officer records."
    }
  }
}
